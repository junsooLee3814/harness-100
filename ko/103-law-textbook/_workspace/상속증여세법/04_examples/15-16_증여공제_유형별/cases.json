{
  "cases": [
    {
      "id": "15-1_혼인공제_부모합산",
      "chapter": "15",
      "desc": "혼인 앞둔 성년 자녀에게 부 1.5억 + 모 5천만 증여 — 부모는 동일인 합산, 기본 5천만+혼인 1억 공제 (가상)",
      "기준연도": "2026 (상증법 §47②·§53·§53의2·§56·§69 — 2026.8 조사 원문 확인)",
      "inputs": {"부_증여": 150000000, "모_증여": 50000000, "기본공제": 50000000, "혼인공제": 100000000},
      "steps": [
        {"name": "합산증여재산", "expr": "부_증여 + 모_증여", "expected": 200000000},
        {"name": "공제합계", "expr": "기본공제 + 혼인공제", "expected": 150000000},
        {"name": "과세표준", "expr": "합산증여재산 - 공제합계", "expected": 50000000},
        {"name": "산출세액",
         "누진세율": {"base": "과세표준",
           "brackets": [[100000000, 0.10, 0], [500000000, 0.20, 10000000],
                        [1000000000, 0.30, 60000000], [3000000000, 0.40, 160000000],
                        [null, 0.50, 460000000]]},
         "expected": 5000000},
        {"name": "신고세액공제", "expr": "round(산출세액 * 0.03)", "expected": 150000},
        {"name": "납부세액", "expr": "산출세액 - 신고세액공제", "expected": 4850000}
      ],
      "최종단계": "납부세액",
      "본문_표기값": 4850000
    },
    {
      "id": "16-1_저가양도_특수관계",
      "chapter": "16",
      "desc": "시가 10억 상가를 아버지가 아들에게 6억에 양도 — 차액 4억 ≥ 기준 3억 → 증여재산가액 1억 (가상)",
      "기준연도": "2026 (상증법 §35①·령§26·§53·§56·§69)",
      "inputs": {"시가": 1000000000, "대가": 600000000, "증여재산공제": 50000000},
      "steps": [
        {"name": "차액", "expr": "시가 - 대가", "expected": 400000000},
        {"name": "기준금액", "expr": "min(시가 * 0.3, 300000000)", "expected": 300000000},
        {"name": "과세판정_1이면과세", "expr": "1 if 차액 >= 기준금액 else 0", "expected": 1},
        {"name": "증여재산가액", "expr": "차액 - 기준금액", "expected": 100000000},
        {"name": "과세표준", "expr": "증여재산가액 - 증여재산공제", "expected": 50000000},
        {"name": "산출세액",
         "누진세율": {"base": "과세표준",
           "brackets": [[100000000, 0.10, 0], [500000000, 0.20, 10000000],
                        [1000000000, 0.30, 60000000], [3000000000, 0.40, 160000000],
                        [null, 0.50, 460000000]]},
         "expected": 5000000},
        {"name": "납부세액", "expr": "산출세액 - round(산출세액 * 0.03)", "expected": 4850000}
      ],
      "최종단계": "납부세액",
      "본문_표기값": 4850000
    },
    {
      "id": "16-2_무이자대출_기준판정",
      "chapter": "16",
      "desc": "부모→자녀 무이자 대출 — 3억이면 이익 1,380만 ≥ 1천만 과세 / 2억이면 920만 미달 제외 (가상. 적정이자율 4.6%)",
      "기준연도": "2026 (상증법 §41의4·규칙§10의5 — 4.6%는 조심2024중5770 적용 확인)",
      "inputs": {"대출금A": 300000000, "대출금B": 200000000, "적정이자율": 0.046},
      "steps": [
        {"name": "이익A", "expr": "대출금A * 적정이자율", "expected": 13800000},
        {"name": "판정A_1이면과세", "expr": "1 if 이익A >= 10000000 else 0", "expected": 1},
        {"name": "이익B", "expr": "대출금B * 적정이자율", "expected": 9200000},
        {"name": "판정B_1이면과세", "expr": "1 if 이익B >= 10000000 else 0", "expected": 0}
      ],
      "최종단계": "판정B_1이면과세",
      "본문_표기값": 0
    }
  ]
}
