        {"name": "납부지연가산세", "expr": "추가본세 * 0.00022 * 지연일수", "expected": 1320000},
        {"name": "가산세_합계", "expr": "과소신고가산세_확정 + 납부지연가산세", "expected": 3820000}
      ],
      "최종단계": "가산세_합계",
      "본문_표기값": 3820000
    },
