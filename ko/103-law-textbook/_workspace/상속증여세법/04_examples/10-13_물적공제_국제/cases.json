{
  "cases": [
    {
      "id": "10-1_금융재산공제",
      "chapter": "10",
      "desc": "금융재산 6억 − 금융채무 1억 = 순금융재산 5억 → 공제 1억 (가상)",
      "기준연도": "2026 (상증법 §22 — 2026.8 조사)",
      "inputs": {"금융재산": 600000000, "금융채무": 100000000},
      "steps": [
        {"name": "순금융재산", "expr": "금융재산 - 금융채무", "expected": 500000000},
        {"name": "공제액", "expr": "min(max(순금융재산 * 0.2, 20000000), 200000000)", "expected": 100000000}
      ],
      "최종단계": "공제액",
      "본문_표기값": 100000000
    },
    {
      "id": "10-2_종합한도_손자유증_함정",
      "chapter": "10",
      "desc": "과세가액 9억, 손자(상속인 아님) 유증 5억, 상속인 자녀 2(배우자 없음) — §24 종합한도로 일괄공제 축소 + §27 할증 (가상)",
      "기준연도": "2026 (상증법 §21·§24·§26·§27·§69)",
      "inputs": {"과세가액": 900000000, "손자유증": 500000000, "일괄공제": 500000000},
      "steps": [
        {"name": "종합한도", "expr": "과세가액 - 손자유증", "expected": 400000000},
        {"name": "공제적용액", "expr": "min(일괄공제, 종합한도)", "expected": 400000000},
        {"name": "과세표준", "expr": "과세가액 - 공제적용액", "expected": 500000000},
        {"name": "산출세액",
         "누진세율": {"base": "과세표준",
           "brackets": [[100000000, 0.10, 0], [500000000, 0.20, 10000000],
                        [1000000000, 0.30, 60000000], [3000000000, 0.40, 160000000],
                        [null, 0.50, 460000000]]},
         "expected": 90000000},
        {"name": "세대생략할증", "expr": "round(산출세액 * (손자유증 / 과세가액) * 0.30)", "expected": 15000000},
        {"name": "산출세액계", "expr": "산출세액 + 세대생략할증", "expected": 105000000},
        {"name": "신고세액공제", "expr": "round(산출세액계 * 0.03)", "expected": 3150000},
        {"name": "납부세액", "expr": "산출세액계 - 신고세액공제", "expected": 101850000}
      ],
      "최종단계": "납부세액",
      "본문_표기값": 101850000
    },
    {
      "id": "13-1_거주자_비거주자_대비",
      "chapter": "13",
      "desc": "같은 국내 재산 10억(과세가액), 배우자+자녀 상속 — 거주자면 세액 0, 비거주자면 1.75억 (가상)",
      "기준연도": "2026 (상증법 §3·§18·§19·§21·§26·§69)",
      "inputs": {"과세가액": 1000000000, "일괄공제": 500000000, "배우자최소공제": 500000000, "기초공제": 200000000},
      "steps": [
        {"name": "거주자_과세표준", "expr": "max(과세가액 - 일괄공제 - 배우자최소공제, 0)", "expected": 0},
        {"name": "거주자_세액", "expr": "0", "expected": 0},
        {"name": "비거주자_과세표준", "expr": "과세가액 - 기초공제", "expected": 800000000},
        {"name": "비거주자_산출세액",
         "누진세율": {"base": "비거주자_과세표준",
           "brackets": [[100000000, 0.10, 0], [500000000, 0.20, 10000000],
                        [1000000000, 0.30, 60000000], [3000000000, 0.40, 160000000],
                        [null, 0.50, 460000000]]},
         "expected": 180000000},
        {"name": "비거주자_신고세액공제", "expr": "round(비거주자_산출세액 * 0.03)", "expected": 5400000},
        {"name": "비거주자_납부세액", "expr": "비거주자_산출세액 - 비거주자_신고세액공제", "expected": 174600000}
      ],
      "최종단계": "비거주자_납부세액",
      "본문_표기값": 174600000
    }
  ]
}
