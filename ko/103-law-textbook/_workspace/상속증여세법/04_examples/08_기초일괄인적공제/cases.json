{
  "cases": [
    {
      "id": "8-1_다자녀_장애인_기초인적_선택",
      "chapter": "8",
      "desc": "과세가액 15억, 배우자+자녀 4(미성년 9세·14세, 성년 장애인 1·기대여명 30년 가정) — 기초+인적(8.5억) > 일괄(5억) 선택 사례 (가상)",
      "기준연도": "2026 (상증법 §18·§19④·§20·§21·§26·§69 — 2026.8 조사 원문 확인. 기대여명 30년은 [가정] — 통계표 확인 필요)",
      "inputs": {
        "과세가액": 1500000000,
        "배우자실제수령": 300000000,
        "기초공제": 200000000,
        "자녀수": 4,
        "미성년A_나이": 9,
        "미성년B_나이": 14,
        "장애인_기대여명": 30
