      "steps": [
        {"name": "자녀공제합", "expr": "자녀수 * 50000000", "expected": 200000000},
        {"name": "미성년공제합", "expr": "10000000 * (19 - 미성년A_나이) + 10000000 * (19 - 미성년B_나이)", "expected": 150000000},
        {"name": "장애인공제", "expr": "10000000 * 장애인_기대여명", "expected": 300000000},
        {"name": "기초인적합", "expr": "기초공제 + 자녀공제합 + 미성년공제합 + 장애인공제", "expected": 850000000},
        {"name": "공제선택", "expr": "max(기초인적합, 500000000)", "expected": 850000000},
        {"name": "배우자공제", "expr": "max(배우자실제수령, 500000000)", "expected": 500000000},
        {"name": "과세표준", "expr": "과세가액 - 공제선택 - 배우자공제", "expected": 150000000},
        {"name": "산출세액",
         "누진세율": {"base": "과세표준",
           "brackets": [[100000000, 0.10, 0], [500000000, 0.20, 10000000],
                        [1000000000, 0.30, 60000000], [3000000000, 0.40, 160000000],
                        [null, 0.50, 460000000]]},
         "expected": 20000000},
        {"name": "신고세액공제", "expr": "round(산출세액 * 0.03)", "expected": 600000},
        {"name": "납부세액", "expr": "산출세액 - 신고세액공제", "expected": 19400000}
      ],
      "최종단계": "납부세액",
      "본문_표기값": 19400000
    },
    {
      "id": "8-2_자녀1_일괄공제_배우자없음",
      "chapter": "8",
      "desc": "과세가액 7억, 상속인 성년 자녀 1인뿐(배우자 기사망) — 일괄공제 5억 선택, 배우자공제 없음 (가상)",
