        {"name": "비교_유증없음_산출세액", "expr": "round(비교_유증없음_산출세액_원)", "expected": 58000000},
        {"name": "비교_유증없음_신고세액공제", "expr": "round(비교_유증없음_산출세액 * 0.03)", "expected": 1740000},
