        {"name": "공제_D_3억",
         "expr": "순금융재산_D if 순금융재산_D <= 20000000 else round(min(max(순금융재산_D * 0.2, 20000000), 200000000))",
         "expected": 60000000},
        {"name": "공제_E_12억",
         "expr": "순금융재산_E if 순금융재산_E <= 20000000 else round(min(max(순금융재산_E * 0.2, 20000000), 200000000))",
