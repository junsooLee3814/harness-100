{
  "cases": [
    {
      "id": "9-1_한도초과_법정상속분_컷",
      "chapter": "9",
      "desc": "과세가액 28억, 배우자+자녀 1(법정상속분 3/5), 배우자 실제 수령 20억 — 한도 16.8억에서 컷 (가상)",
      "기준연도": "2026 (상증법 §19①·§21·§26·§69 — 2026.8 조사. B=C=E=0 단순형)",
      "inputs": {
        "과세가액": 2800000000,
        "배우자실제수령": 2000000000,
        "일괄공제": 500000000,
        "배우자공제상한": 3000000000
      },
      "steps": [
        {"name": "배우자한도", "expr": "min(과세가액 * 3 / 5, 배우자공제상한)", "expected": 1680000000},
        {"name": "배우자공제", "expr": "min(배우자실제수령, 배우자한도)", "expected": 1680000000},
        {"name": "과세표준", "expr": "과세가액 - 일괄공제 - 배우자공제", "expected": 620000000},
        {"name": "산출세액",
         "누진세율": {"base": "과세표준",
           "brackets": [[100000000, 0.10, 0], [500000000, 0.20, 10000000],
                        [1000000000, 0.30, 60000000], [3000000000, 0.40, 160000000],
                        [null, 0.50, 460000000]]},
         "expected": 126000000},
        {"name": "신고세액공제", "expr": "round(산출세액 * 0.03)", "expected": 3780000},
        {"name": "납부세액", "expr": "산출세액 - 신고세액공제", "expected": 122220000}
      ],
      "최종단계": "납부세액",
      "본문_표기값": 122220000
    },
    {
      "id": "9-2_사전증여_한도식_심화",
      "chapter": "9",
      "desc": "본래 상속재산 18억 + 사전증여 가산 10억(배우자 8억·자녀 2억) = 과세가액 28억. 배우자+자녀 2(3/7), 배우자 실제 수령 11억 — 한도식 (A+C)×D−E 실증 (가상. 증여세액공제 안분한도 §28② 미적용 전제 명시)",
      "기준연도": "2026 (상증법 §19①·§13·§28·§53·§21·§26·§69)",
      "inputs": {
        "본래상속재산": 1800000000,
        "사전증여가산": 1000000000,
        "배우자수증가액": 800000000,
        "자녀수증가액": 200000000,
        "배우자증여공제": 600000000,
        "자녀증여공제": 50000000,
        "배우자실제수령": 1100000000,
        "일괄공제": 500000000,
        "배우자공제상한": 3000000000
      },
      "steps": [
        {"name": "과세가액", "expr": "본래상속재산 + 사전증여가산", "expected": 2800000000},
        {"name": "배우자수증과세표준", "expr": "배우자수증가액 - 배우자증여공제", "expected": 200000000},
        {"name": "배우자한도", "expr": "min((본래상속재산 + 사전증여가산) * 3 / 7 - 배우자수증과세표준, 배우자공제상한)", "expected": 1000000000},
        {"name": "배우자공제", "expr": "min(배우자실제수령, 배우자한도)", "expected": 1000000000},
        {"name": "과세표준", "expr": "과세가액 - 일괄공제 - 배우자공제", "expected": 1300000000},
        {"name": "산출세액",
         "누진세율": {"base": "과세표준",
           "brackets": [[100000000, 0.10, 0], [500000000, 0.20, 10000000],
                        [1000000000, 0.30, 60000000], [3000000000, 0.40, 160000000],
                        [null, 0.50, 460000000]]},
         "expected": 360000000},
        {"name": "배우자기납부증여세", "expr": "배우자수증과세표준 * 0.2 - 10000000", "expected": 30000000},
        {"name": "자녀기납부증여세", "expr": "(자녀수증가액 - 자녀증여공제) * 0.2 - 10000000", "expected": 20000000},
        {"name": "증여세액공제", "expr": "배우자기납부증여세 + 자녀기납부증여세", "expected": 50000000},
        {"name": "신고세액공제", "expr": "round((산출세액 - 증여세액공제) * 0.03)", "expected": 9300000},
        {"name": "납부세액", "expr": "산출세액 - 증여세액공제 - 신고세액공제", "expected": 300700000}
      ],
      "최종단계": "납부세액",
      "본문_표기값": 300700000
    }
  ]
}
