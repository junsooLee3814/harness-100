# Supabase 프로젝트 설정 (Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 서버 전용 — 다운로드 서명 URL 생성 및 프로비저닝 스크립트용.
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것. Vercel에는 "Sensitive"로 등록.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# (선택) 매직링크 리다이렉트 기준 URL — 미설정 시 요청 Origin 사용
# NEXT_PUBLIC_SITE_URL=https://your-portal.vercel.app
